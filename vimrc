" ---------- Indentation ----------
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set smartindent

" ---------- Search ----------
set ignorecase
set smartcase
set incsearch
set hlsearch

" ---------- UI ----------
set number
set cursorline
syntax on
set laststatus=2
set statusline=%f   " show relative file path at bottom

" ---------- Clipboard ----------
set clipboard=
