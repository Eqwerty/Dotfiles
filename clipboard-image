#!/usr/bin/env bash
 set -euo pipefail

 SAVE_DIR="${CIMG_DIR:-$HOME/.clip-snaps}"
 FILENAME="img_$(date +%Y%m%d_%H%M%S).png"
 OUTPUT_PATH="$SAVE_DIR/$FILENAME"

 if [ "${1:-}" = "--purge" ]; then
   if [ ! -d "$SAVE_DIR" ] || [ -z "$(ls -A "$SAVE_DIR" 2>/dev/null)" ]; then
     echo "Nothing to purge in $SAVE_DIR"
     exit 0
   fi
   COUNT=$(ls "$SAVE_DIR"/*.png 2>/dev/null | wc -l)
   rm -f "$SAVE_DIR"/*.png
   echo "Purged $COUNT image(s) from $SAVE_DIR"
   exit 0
 fi

 # Find powershell.exe (works on both WSL and Git Bash / native Windows)
 if command -v powershell.exe >/dev/null 2>&1; then
   POWERSHELL="powershell.exe"
 elif [ -x "/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe" ]; then
   POWERSHELL="/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"
 else
   echo "Error: powershell.exe not found."
   exit 1
 fi

 if ! command -v clip.exe >/dev/null 2>&1; then
   echo "Error: clip.exe not found."
   exit 1
 fi

 mkdir -p "$SAVE_DIR"

 # Convert WSL/Git Bash path to Windows path for PowerShell
 if command -v wslpath >/dev/null 2>&1; then
   WIN_PATH=$(wslpath -w "$OUTPUT_PATH")
 elif command -v cygpath >/dev/null 2>&1; then
   WIN_PATH=$(cygpath -w "$OUTPUT_PATH")
 else
   WIN_PATH="$OUTPUT_PATH"
 fi

 if ! "$POWERSHELL" -NoProfile -STA -Command "
   Add-Type -Assembly System.Windows.Forms
   \$img = [System.Windows.Forms.Clipboard]::GetImage()
   if (\$img -eq \$null) { exit 1 }
   \$img.Save('$WIN_PATH')
 " 2>/dev/null; then
   rm -f "$OUTPUT_PATH"
   echo "Error: clipboard does not contain an image."
   exit 1
 fi

 if [ ! -s "$OUTPUT_PATH" ]; then
   rm -f "$OUTPUT_PATH"
   echo "Error: clipboard does not contain an image."
   exit 1
 fi

 if command -v iconv >/dev/null 2>&1; then
   printf '%s' "$OUTPUT_PATH" | iconv -f UTF-8 -t UTF-16LE | clip.exe
 else
   printf '%s' "$OUTPUT_PATH" | clip.exe
 fi

 echo "Copied to clipboard: $OUTPUT_PATH"
